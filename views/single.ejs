<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= foundedProduct.title %>
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
</head>

<body>
  <nav class="navbar sm:navbar-expand bg-1 fg-2">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">Navbar</a>
      <button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#navbarNavAltMarkup"
        aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon" aria-hidden="true"></span>
      </button>
      <dialog class="drawer drawer-end" tabindex="-1" id="navbarNavAltMarkup" aria-labelledby="navbarNavAltMarkupLabel">
        <div class="drawer-header">
          <h5 class="drawer-title" id="navbarNavAltMarkupLabel">Menu</h5>
          <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close"></button>
        </div>
        <div class="drawer-body">
          <div class="nav nav-pills navbar-nav">
            <a class="nav-link active" aria-current="page" href="#">Home</a>
            <a class="nav-link" href="#">Features</a>
            <a class="nav-link" href="#">Pricing</a>
            <a class="nav-link disabled" aria-disabled="true">Disabled</a>
          </div>
        </div>
      </dialog>
    </div>
  </nav>

  <div class="container">
    <h1 class="mt-5 mb-3">
      <%= foundedProduct.title %>
    </h1>
    <div class="d-flex justify-content-between flex-wrap">
      <section class="card" style="width: 100%">
        <img src="https://picsum.photos/1200/1200" class="card-img-top" alt="..." height="600">
        <div class="card-body">
          <h4 class="card-title">
            <%= foundedProduct.title %>
          </h4>
          <p class="card-text">
            <%=foundedProduct.desc%>
          </p>
          <p class="card-text">
            <%=foundedProduct.price%>
          </p>
          <div class="d-flex gap-3">
            <form method="post" action="/delete_product/<%= foundedProduct.id %>">
              <button type="submit" class="btn-solid btn-styled theme-danger">delete</button>
            </form>
            <button type="button" class="btn-solid theme-warning" data-bs-toggle="dialog"
              data-bs-target="#instantDialog">
              update
            </button>
          </div>

          <dialog class="dialog dialog-instant" id="instantDialog">
            <div class="dialog-header">
              <h1 class="dialog-title">
                <%= foundedProduct.title %>
              </h1>
              <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Close"></button>
            </div>
            <div class="dialog-body">
              <form action="/update_product/<%= foundedProduct.id %>" method="post">
                <label for="exampleFormControlInput" class="form-label mb-2">Title</label>
                <input type="text" class="form-control mb-3" id="exampleFormControlInput" placeholder="laptop..."
                  name="title" value="<%= foundedProduct.title %>">

                <label for="exampleFormdesc" class="form-label mb-2">Description</label>
                <input type="text" class="form-control mb-3" id="exampleFormdesc" placeholder="new laptop..."
                  name="desc" value="<%= foundedProduct.desc %>">

                <label for="exampleFormprice" class="form-label mb-2">Price</label>
                <input type="text" class="form-control" id="exampleFormprice" placeholder="120$" name="price"
                value="<%= foundedProduct.price %>">

                <button type="submit" class="btn-solid mt-5 theme-primary">Save changes</button>
              </form>
            </div>
          </dialog>
        </div>
      </section>
    </div>
  </div>



  <!-- bootstrap  -->
  <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL"
    crossorigin="anonymous"></script>
</body>

</html>