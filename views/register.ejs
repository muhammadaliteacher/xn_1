<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SignUp</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
</head>

<body>
  <div class="container">
      <h1>Sign Up</h1>
    <form action="/register" method="post" class="w-25" id="signupForm">
      <label for="username" class="form-label mb-2">Username</label>
      <input type="text" class="form-control mb-3" id="username" placeholder="username..." name="username">

      <label for="email" class="form-label mb-2">Email</label>
      <input type="email" class="form-control email mb-3" id="email" placeholder="email..." name="email">

      <label for="password" class="form-label mb-2">Password</label>
      <input type="password" class="form-control" id="password" placeholder="password..." name="password">

      <button type="submit" class="btn-solid mt-5 theme-primary">Sign Up</button>
    </form>
  </div>


  <script>
    const form = document.querySelector("#signupForm");

    form.addEventListener("submit", function () {
      const email = document.querySelector("#email").value;

      localStorage.setItem("email", email);
    });
  </script>
    <!-- bootstrap  -->
  <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL"
    crossorigin="anonymous"></script>
</body>

</html>